      <memberdef kind="function" id="structcuda_1_1experimental_1_1hierarchy__dimensions_1a3cf2eed7c5b547d7797b5034d0994c09" prot="public" static="no" constexpr="yes" const="yes" explicit="no" inline="yes" noexcept="yes" virt="non-virtual">
