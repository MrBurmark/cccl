        <definition>constexpr auto cuda::experimental::hierarchy_dimensions&lt; BottomUnit, Levels &gt;::count</definition>
        <argsstring>(const Unit &amp;=Unit(), const Level &amp;=Level()) const noexcept</argsstring>
        <name>count</name>
        <param>
