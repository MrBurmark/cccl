<sect4 id="traits_8cuh_1example">
<title>Example</title>
<para><programlisting filename="/home/runner/work/cccl/cccl/cudax/include/cuda/experimental/__stf/utility/cuda_safe_call.cuh"><codeline><highlight class="normal">UNITTEST(</highlight><highlight class="stringliteral">&quot;cuda_exception&quot;</highlight><highlight class="normal">)</highlight></codeline>
