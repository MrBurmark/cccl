        <name>equal</name>
        <param>
          <type>const thrust::detail::execution_policy_base&lt; DerivedPolicy &gt; &amp;</type>
          <declname>exec</declname>
        </param>
        <param>
          <type>InputIterator1</type>
          <declname>first1</declname>
        </param>
