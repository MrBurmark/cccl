<parameternamelist>
<parametername>bytes</parametername>
</parameternamelist>
<parameterdescription>
<para>size, in bytes, that is requested from this allocation </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>alignment</parametername>
</parameternamelist>
<parameterdescription>
<para>alignment that is requested from this allocation </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="exception"><parameteritem>
<parameternamelist>
<parametername>thrust::bad_alloc</parametername>
</parameternamelist>
