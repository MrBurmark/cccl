<codeline><highlight class="normal">#include<sp/>&lt;thrust/execution_policy.h&gt;</highlight></codeline>
<codeline><highlight class="normal">...</highlight></codeline>
<codeline><highlight class="normal">thrust::device_vector&lt;int&gt;<sp/>v(4);</highlight></codeline>
<codeline><highlight class="normal">thrust::fill(thrust::device,<sp/>v.begin(),<sp/>v.end(),<sp/>137);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>v[0]<sp/>==<sp/>137,<sp/>v[1]<sp/>==<sp/>137,<sp/>v[2]<sp/>==<sp/>137,<sp/>v[3]<sp/>==<sp/>137</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ulink url="https://en.cppreference.com/w/cpp/algorithm/fill">https://en.cppreference.com/w/cpp/algorithm/fill</ulink> </para>
