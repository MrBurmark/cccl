        <definition>using cub::WarpExchange&lt; InputT, ITEMS_PER_THREAD, LOGICAL_WARP_THREADS, WARP_EXCHANGE_ALGORITHM &gt;::TempStorage =  typename InternalWarpExchange::TempStorage</definition>
