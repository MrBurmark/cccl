        <name>_CubLog</name>
        <param><defname>format</defname></param>
        <param><defname>...</defname></param>
        <initializer>    do                                                            \
    {                                                             \
      NV_IF_TARGET(                                               \
        NV_IS_HOST,                                               \
        (printf(format, __VA_ARGS__);),                           \
        (printf(&quot;[block (%d,%d,%d), thread (%d,%d,%d)]: &quot; format, \
                blockIdx.z,                                       \
                blockIdx.y,                                       \
                blockIdx.x,                                       \
                threadIdx.z,                                      \
                threadIdx.y,                                      \
                threadIdx.x,                                      \
                __VA_ARGS__);));                                  \
    } while (false)</initializer>
