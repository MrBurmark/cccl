      <memberdef kind="variable" id="structthrust_1_1mr_1_1pool__options_1af80c671e926dc356530a334da37fe3b3" prot="public" static="no" mutable="no">
        <type>std::size_t</type>
        <definition>std::size_t thrust::mr::pool_options::cached_size_cutoff_factor</definition>
        <argsstring></argsstring>
        <name>cached_size_cutoff_factor</name>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>The size factor at which a cached allocation is considered too ridiculously oversized to use to fulfill an allocation request. For instance: the user requests an allocation of size 1024 bytes. A block of size 32 * 1024 bytes is cached. If <computeroutput>cached_size_cutoff_factor</computeroutput> is 32 or less, this block will be considered too big for that allocation request. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="thrust/mr/pool_options.h" line="93" column="15" bodyfile="thrust/mr/pool_options.h" bodystart="93" bodyend="-1"/>
