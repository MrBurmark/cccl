</parameternamelist>
<parameterdescription>
<para>The beginning of the sequence. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>last</parametername>
</parameternamelist>
<parameterdescription>
<para>The end of the sequence. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>unary_op</parametername>
</parameternamelist>
<parameterdescription>
<para>The function to apply to each element of the input sequence. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>init</parametername>
</parameternamelist>
<parameterdescription>
<para>The result is initialized to this value. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>binary_op</parametername>
</parameternamelist>
<parameterdescription>
<para>The reduction operation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The result of the transformed reduction.</para>
</simplesect>
