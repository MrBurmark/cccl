</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>binary_op1</parametername>
</parameternamelist>
<parameterdescription>
<para>Generalized addition operation. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>binary_op2</parametername>
</parameternamelist>
<parameterdescription>
<para>Generalized multiplication operation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The inner product of sequences <computeroutput>[first1, last1)</computeroutput> and <computeroutput>[first2, last2)</computeroutput>.</para>
