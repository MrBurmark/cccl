<codeline><highlight class="normal">thrust::all_of(thrust::host,<sp/>A,<sp/>A<sp/>+<sp/>2,<sp/>::cuda::std::identity{});<sp/>//<sp/>returns<sp/>true</highlight></codeline>
<codeline><highlight class="normal">thrust::all_of(thrust::host,<sp/>A,<sp/>A<sp/>+<sp/>3,<sp/>::cuda::std::identity{});<sp/>//<sp/>returns<sp/>false</highlight></codeline>
