    <briefdescription>
<para>Type representing a result of a multi-dimensional hierarchy query. </para>
    </briefdescription>
    <detaileddescription>
<para>Returned from extents and index queries.</para>
<para><simplesect kind="par"><title>Snippet</title><para><programlisting><codeline><highlight class="normal">#include<sp/>&lt;cudax/hierarchy_dimensions.cuh&gt;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">template<sp/>&lt;typename<sp/>Dimensions&gt;</highlight></codeline>
<codeline><highlight class="normal">__global__<sp/>void<sp/>kernel(Dimensions<sp/>dims)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>auto<sp/>ext<sp/>=<sp/>dims.extents();</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Can<sp/>be<sp/>accessed<sp/>like<sp/>cuda::std::extents<sp/>or<sp/>like<sp/>dim3</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>assert(ext.extent(0)<sp/>==<sp/>expected);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>assert(ext.x<sp/>==<sp/>expected);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Can<sp/>be<sp/>converted<sp/>to<sp/>dim3</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>dim3<sp/>dimensions<sp/>=<sp/>ext;</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
</simplesect>
